{
  "tools": {
    "cmake": "cmake",
    "ninja": "ninja",
    "cc": "cl",
    "cxx": "cl",
    "java": "%JAVA_HOME%/bin/java.exe",
    "javac": "%JAVA_HOME%/bin/javac.exe",
    "kotlinc": "<Kotlin SDK>/bin/kotlinc.bat",
    "dotnet": "dotnet",
    "node": "node",
    "tsc": "editors/vscode/node_modules/typescript/bin/tsc",
    "go": "go",
    "rustc": "rustc",
    "cargo": "cargo",
    "swiftc": "swiftc"
  },
  "dotnet_sdk": "8.0.426",
  "runtime_prefix": "<immutable installed Serializer runtime prefix>",
  "dependency_prefix": "<native dependency prefix>",
  "provider_include": "<native dependency prefix>/include",
  "provider_library": "<native dependency prefix>/lib",
  "zlib_library": "<native dependency prefix>/lib/z.lib",
  "zstd_library": "<native dependency prefix>/lib/zstd.lib",
  "lz4_library": "<native dependency prefix>/lib/lz4.lib",
  "zstd_jar": "<provider directory>/zstd-jni-1.5.7-16.jar",
  "lz4_jar": "<provider directory>/lz4-java-1.12.0.jar",
  "zstd_dll": "<provider directory>/ZstdSharp.dll",
  "lz4_dll": "<provider directory>/K4os.Compression.LZ4.dll",
  "lz4_module": "<provider directory>/lz4js/lz4.js",
  "python_provider": "<python-lz4 provider directory>",
  "cargo_home": "<populated offline Cargo home>",
  "go_cache": "<populated offline Go module cache>",
  "cpp_helper": "<immutable compression_interop executable>",
  "cpp_linked_helper": "<immutable compression_linked_lz4 executable>"
}
