serializer version 1.21.0;

namespace reproducibility {
  xml(namespace("urn:serializer:reproducibility"), scalars(attribute));
  class marker { public uint32 id (1); }
  package archive {
    part marker : marker {
      name("/unused-marker.xml");
      content_type("application/vnd.serializer.marker+xml");
      relationship("urn:serializer:reproducibility:marker");
      occurs(0, 1);
    }
  }
}
