include_guard(GLOBAL)

# Resolve the output layout without requiring an already-built compiler during configuration.
function(_serializer_include_mode result configuration override)
  set(mode separate)
  if(configuration)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${configuration}")
    file(STRINGS "${configuration}" lines)
    set(section)
    foreach(line IN LISTS lines)
      string(STRIP "${line}" line)
      if(line MATCHES "^\\[[ \t]*([^]]+)[ \t]*\\]$")
        string(STRIP "${CMAKE_MATCH_1}" section)
      elseif(section STREQUAL "output" AND line MATCHES "^include_mode[ \t]*=[ \t]*(.*)$")
        string(STRIP "${CMAKE_MATCH_1}" mode)
        if(mode MATCHES "^\"(.*)\"$")
          set(mode "${CMAKE_MATCH_1}")
        endif()
      endif()
    endforeach()
  endif()
  if(override)
    set(mode "${override}")
  endif()
  if(NOT mode MATCHES "^(separate|inline)$")
    message(FATAL_ERROR "Serializer INCLUDE_MODE/output.include_mode must be separate or inline")
  endif()
  set(${result} "${mode}" PARENT_SCOPE)
endfunction()

# Register the leading include graph for reconfiguration and predict its separate C++ artifacts.
# The compiler still validates syntax, declarations, cycles, and language versions at build time.
function(_serializer_include_outputs result schema output mode)
  set(${result} "" PARENT_SCOPE)
  if(mode STREQUAL "inline")
    return()
  endif()
  file(REAL_PATH "${schema}" root)
  set(pending "${root}")
  set(dependencies)
  while(pending)
    list(POP_FRONT pending input)
    if(NOT EXISTS "${input}" OR IS_DIRECTORY "${input}")
      continue()
    endif()
    file(REAL_PATH "${input}" input)
    if(input IN_LIST dependencies)
      continue()
    endif()
    list(APPEND dependencies "${input}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
    file(READ "${input}" source)
    # Only leading schema directives matter; embedded language bodies are never scanned.
    string(REGEX REPLACE "/\\*([^*]|\\*+[^*/])*\\*+/" " " source "${source}")
    string(REGEX REPLACE "//[^\n]*" " " source "${source}")
    string(REGEX REPLACE
      "^[ \t\r\n]*serializer[ \t\r\n]+version[ \t\r\n]+[0-9.]+[ \t\r\n]*;"
      "" source "${source}")
    while(source MATCHES
        "^[ \t\r\n]*include([ \t\r\n]+[^ \t\r\n;]+|[./-][^ \t\r\n;]*)[ \t\r\n]*;")
      set(directive "${CMAKE_MATCH_0}")
      string(STRIP "${CMAKE_MATCH_1}" relative)
      get_filename_component(extension "${relative}" LAST_EXT)
      get_filename_component(filename "${relative}" NAME)
      if(NOT extension OR filename MATCHES "^[.][^.]+$")
        string(APPEND relative ".serializer")
      endif()
      get_filename_component(directory "${input}" DIRECTORY)
      get_filename_component(included "${relative}" ABSOLUTE BASE_DIR "${directory}")
      list(APPEND pending "${included}")
      string(LENGTH "${directive}" directive_length)
      string(SUBSTRING "${source}" ${directive_length} -1 source)
    endwhile()
  endwhile()
  get_filename_component(ancestor "${root}" DIRECTORY)
  foreach(dependency IN LISTS dependencies)
    file(RELATIVE_PATH relative "${ancestor}" "${dependency}")
    while(relative MATCHES "^[.][.](/|$)" OR IS_ABSOLUTE "${relative}")
      get_filename_component(parent "${ancestor}" DIRECTORY)
      if(parent STREQUAL ancestor)
        message(FATAL_ERROR "Serializer included schemas must share a source filesystem root")
      endif()
      set(ancestor "${parent}")
      file(RELATIVE_PATH relative "${ancestor}" "${dependency}")
    endwhile()
  endforeach()
  get_filename_component(extension "${output}" LAST_EXT)
  get_filename_component(filename "${output}" NAME)
  if(filename MATCHES "^[.][^.]+$")
    set(extension)
  endif()
  set(outputs)
  foreach(dependency IN LISTS dependencies)
    if(NOT dependency STREQUAL root)
      file(RELATIVE_PATH relative "${ancestor}" "${dependency}")
      string(REGEX REPLACE "[.]serializer$" "${extension}" relative "${relative}")
      list(APPEND outputs "${output}.includes/${relative}")
    endif()
  endforeach()
  set(${result} "${outputs}" PARENT_SCOPE)
endfunction()
