@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@SERIALIZER_WITH_ZSTD@)
  find_dependency(zstd CONFIG)
endif()
if(@SERIALIZER_WITH_LZ4@)
  find_dependency(lz4 CONFIG)
endif()
if(@SERIALIZER_WITH_ZLIB@)
  find_dependency(ZLIB)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SerializerTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/serializer_generate.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/serializer_generate_java.cmake")

check_required_components(Serializer)
