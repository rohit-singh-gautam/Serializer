@PACKAGE_INIT@

# Unqualified discovery retains the complete historical target/dependency set.
set(Serializer_FOUND TRUE)
unset(Serializer_NOT_FOUND_MESSAGE)
set(Serializer_compiler_FOUND TRUE)
set(Serializer_runtime_FOUND FALSE)
set(_serializer_supported_components FALSE)
set(_serializer_load_runtime FALSE)
set(_serializer_runtime_required FALSE)
foreach(_serializer_component IN LISTS Serializer_FIND_COMPONENTS)
  if(_serializer_component STREQUAL "compiler")
    set(_serializer_supported_components TRUE)
  elseif(_serializer_component STREQUAL "runtime")
    set(_serializer_supported_components TRUE)
    set(_serializer_load_runtime TRUE)
    if(Serializer_FIND_REQUIRED_runtime)
      set(_serializer_runtime_required TRUE)
    endif()
  else()
    set(Serializer_${_serializer_component}_FOUND FALSE)
    if(Serializer_FIND_REQUIRED_${_serializer_component})
      set(Serializer_FOUND FALSE)
      set(Serializer_NOT_FOUND_MESSAGE "Unsupported Serializer component: ${_serializer_component}")
      return()
    endif()
  endif()
endforeach()
# Ignored optional names must not change the historical unqualified package.
if(NOT _serializer_supported_components)
  set(_serializer_load_runtime TRUE)
  set(_serializer_runtime_required TRUE)
endif()
# A target-ABI mismatch makes an optional runtime unavailable, preserving the host tool.
if(_serializer_load_runtime AND NOT _serializer_runtime_required AND CMAKE_SIZEOF_VOID_P AND
    NOT CMAKE_SIZEOF_VOID_P STREQUAL "@CMAKE_SIZEOF_VOID_P@")
  set(_serializer_load_runtime FALSE)
endif()

if(_serializer_load_runtime)
  include(CMakeFindDependencyMacro)
  set(_serializer_runtime_dependencies)
  if(@SERIALIZER_WITH_ZSTD@)
    list(APPEND _serializer_runtime_dependencies zstd)
  endif()
  if(@SERIALIZER_WITH_LZ4@)
    list(APPEND _serializer_runtime_dependencies lz4)
  endif()
  if(@SERIALIZER_WITH_ZLIB@)
    list(APPEND _serializer_runtime_dependencies ZLIB)
  endif()
  if(@SERIALIZER_WITH_XML@)
    list(APPEND _serializer_runtime_dependencies LibXml2)
  endif()
  set(_serializer_runtime_available TRUE)
  foreach(_serializer_dependency IN LISTS _serializer_runtime_dependencies)
    set(_serializer_dependency_arguments)
    if(_serializer_dependency STREQUAL "zstd" OR _serializer_dependency STREQUAL "lz4")
      list(APPEND _serializer_dependency_arguments CONFIG)
    endif()
    if(NOT _serializer_runtime_required)
      # Optional runtime discovery must not inherit REQUIRED from the host compiler.
      find_package(${_serializer_dependency} ${_serializer_dependency_arguments} QUIET)
      if(NOT ${_serializer_dependency}_FOUND)
        set(_serializer_runtime_available FALSE)
        break()
      endif()
    else()
      find_dependency(${_serializer_dependency} ${_serializer_dependency_arguments})
    endif()
  endforeach()
  if(_serializer_runtime_available)
    include("${CMAKE_CURRENT_LIST_DIR}/SerializerTargets.cmake")
    set(Serializer_runtime_FOUND TRUE)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SerializerCompilerTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/serializer_generate.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/serializer_generate_java.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/serializer_generate_source.cmake")

check_required_components(Serializer)
