serializer version 1;

namespace versioning_test {
  class record stable_ids {
    public version { 10 } compatibility { 8 };
    public uint64 id (2);
    created(9) public bool enabled (3) { true };
    obsolete(10) public string old_name (4);
    created(10) replaced(old_name) public string name (5) { "new" };
    reserve id { 7, 9 } variable { retired } display { "retired_wire" };
  }

  class dotted stable_ids {
    public uint64 id (2);
    public version version3 ver ("schema_version", 6) { "1.10.0" } compatibility { "1.2.0" };
    obsolete("1.3.0") public uint16 old_value (3);
    created("1.3.0") replaced(old_value) public uint16 value (4) { 42 };
  }

  class floating stable_ids {
    public version double { 2.5 } compatibility { 1.5 };
    created(2.0) public uint32 value (2) { 42 };
  }

  class private_version stable_ids {
    private version uint16 ver (8) { 300 };
    public uint32 value (2);
  }

  class envelope stable_ids {
    public version { 1 };
    public array record values (2);
  }
}
