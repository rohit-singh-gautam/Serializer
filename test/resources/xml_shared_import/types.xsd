<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="Amount">
    <xs:restriction base="xs:unsignedInt">
      <xs:minInclusive value="2"/>
      <xs:maxExclusive value="9"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Amounts">
    <xs:list itemType="Amount"/>
  </xs:simpleType>
  <xs:simpleType name="AmountPair">
    <xs:restriction base="Amounts"><xs:length value="2"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Selection">
    <xs:union memberTypes="xs:QName xs:unsignedInt"/>
  </xs:simpleType>
  <xs:simpleType name="Selections">
    <xs:list itemType="Selection"/>
  </xs:simpleType>
  <xs:complexType name="Price">
    <xs:simpleContent>
      <xs:extension base="Amount">
        <xs:attribute name="unit" type="xs:string"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="Item">
    <xs:sequence>
      <xs:element name="price" type="Price"/>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required"/>
  </xs:complexType>
</xs:schema>
