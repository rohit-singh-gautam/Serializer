  public optional<T> value (1);
}

class optional_record stable_ids {
  public optional<int32> scalar (1);
  public optional<optional<string>> nested (2);
  public optional<optional_detail> detail (3);
  public optional<array<optional<uint16>>> values (4);
  public optional<map<string, optional<uint32>>> lookup (5);
  public array optional<string> labels (6);
  public map(string) optional<uint32> thresholds (7);
  public optional<optional_color> color (8);
  public array optional<optional_color> colors (9);
