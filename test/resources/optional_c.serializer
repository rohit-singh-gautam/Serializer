serializer version 1.7.0;

enum optional_state {
  ready,
  done
}

class optional_record stable_ids {
  public string name (1) { "fresh" };
  public array uint32 numbers (2);
}

class optional_scalar stable_ids {
  public optional<uint32> value (1);
}

class optional_value stable_ids {
  public optional<uint32> scalar (1);
  public optional<optional_record> record (2);
  public optional<optional<string>> nested (3);
  public optional<array<optional<string>>> list (4);
  public optional<map<string, optional<optional_record>>> mapping (5);
