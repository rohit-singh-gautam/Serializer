serializer version 1.8.0;

enum readonly_phase { idle, ready }
class readonly_identity {
  public uint64 identity;
  public bool enabled;
  public readonly_phase phase;
  public array[3] uint64 values;
  public function bool matches(uint64 candidate) readonly expression(identity == candidate);
  public function bool ready() readonly expression(enabled && phase == readonly_phase::ready);
  public function bool indexed(int64 index, uint64 candidate) readonly predicate(values[index] == candidate);
  public function bool positive() readonly predicate(all(values, 3, item => item > 0));
  public function bool too_many() readonly predicate(all(values, 2, item => item > 0));
  public function bool finite(double value) readonly predicate(math.is_finite(value));
  public function bool guarded(bool inspect, double value) readonly predicate(!inspect || math.sqrt(value) > 0.0);
  public function bool ratio(double denominator) readonly predicate(1.0 / denominator > 0.0);
}

// Unrelated nonliteral storage must not suppress a scalar readonly method's constexpr declaration.
class readonly_nonliteral {
  public uint64 identity;
  public map<uint64, uint64> cache;
  public function bool matches(uint64 candidate) readonly expression(identity == candidate);
}

// Checked arithmetic can run with runtime values or inside C++20 constant evaluation.
class readonly_arithmetic {
  public double amount {12.0};
  public function double sum(double extra) readonly expression(amount + extra);
  public function double difference(double extra) readonly expression(amount - extra);
  public function double scaled(double factor) readonly expression(amount * factor);
  public function double divided(double denominator) readonly expression(amount / denominator);
  public function double signed_value(bool positive) readonly expression(positive ? +amount : -amount);
  public function double converted(uint32 input) readonly expression(to_double(input));
  public function bool scaled_positive(double factor) readonly predicate(amount * factor > 0.0);
}
