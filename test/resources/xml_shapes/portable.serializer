serializer version 1.20.0;

include model;

// Expanded concrete instances are qualified separately from C++ template XML support.
namespace shapes {
  class box<T> {
    public T value;
  }
  instantiate integer_box = box<uint32>;
  instantiate text_box = box<string>;
}
