serializer version 1.20.0;

namespace shapes {
  class names {
    xml(namespace("urn:root"));
    public string unqualified xml(namespace(""));
    public string foreign xml(namespace("urn:foreign"));
    public string language xml(attribute, namespace("http://www.w3.org/XML/1998/namespace"), name("lang"));
    public string qualified xml(attribute, namespace("urn:attribute"));
  }
  enum state {
    zero,
    one
  }
  class child {
    public int16 value;
  }
  class price {
    public string currency;
    public double value;
  }
  class catalog {
    public array price prices;
    public array string labels;
  }
  class record {
    public uint64 big;
    public string label;
    public optional<bool> flag;
    public child nested;
    public array child children;
    public array[2] state states;
    public double amount;
    public float small;
  }
}
