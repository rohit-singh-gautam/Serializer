serializer version 1.17.0;

namespace shapes {
  enum state {
    zero,
    one
  }
  class child {
    public int16 value;
  }
  class price {
    public string currency;
    public double value;
  }
  class catalog {
    public array price prices;
    public array string labels;
  }
  class record {
    public uint64 big;
    public string label;
    public optional<bool> flag;
    public child nested;
    public array child children;
    public array[2] state states;
    public double amount;
    public float small;
  }
}
