<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:complexType name="left">
    <xs:simpleContent><xs:extension base="xs:string"/></xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="right">
    <xs:attribute name="id" type="xs:unsignedInt" use="required"/>
  </xs:complexType>
  <xs:element name="left" type="left"/>
  <xs:element name="right" type="right"/>
  <xs:element name="root">
    <xs:complexType>
      <xs:choice minOccurs="2" maxOccurs="3">
        <xs:sequence><xs:element ref="left"/><xs:element ref="right"/></xs:sequence>
        <xs:sequence><xs:element ref="right"/><xs:element ref="left"/></xs:sequence>
      </xs:choice>
    </xs:complexType>
  </xs:element>
  <xs:element name="fixed">
    <xs:complexType>
      <xs:choice minOccurs="3" maxOccurs="3">
        <xs:element ref="left"/><xs:element ref="right"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>
</xs:schema>
