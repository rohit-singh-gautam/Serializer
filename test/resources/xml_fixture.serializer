serializer version 1.20.0;

namespace xml_fixture {
  enum state { open, closed }
  class item {
    public string label;
    public int32 count;
  }
  class order {
    public uint32 id;
    public string customer;
    public array item items;
    public optional<string> note;
    public state status;
    public array[2] uint16 codes;
  }
  class nullable {
    public optional<string> nil_value;
    public optional<optional<string>> states;
    public optional<optional<array<string>>> entries;
  }
  class nullable_holder {
    public nullable value;
  }
  class maps {
    public map(uint32) string values;
    public optional<map<uint32,string>> optional_values;
  }
  class variants {
    public variant(uint32=code,string=text,item=record) value;
    public union(uint32=code,double=number) primitive;
  }
  class typed_variants {
    public variant(uint32=code,string=text,item=record) value;
  }
  class mixed_fragment {
    private variant(string=text,item=record) value;
  }
  class mixed_content {
    public uint32 id;
    private array mixed_fragment content;
  }
  class fixed_mixed_content {
    public array[3] mixed_fragment content;
  }
  class model_numeric {
    public magic { 'SRL' };
    public version uint64 ver { 9007199254740995 } compatibility { 9007199254740993 };
    public uint32 kept;
    obsolete(9007199254740994) public string old { "old-default" };
    created(9007199254740994) public string current { "new-default" };
  }
  class model_dotted {
    public version version3 ver { "1.10.0" } compatibility { "1.2.0" };
    obsolete("1.3.0") public uint32 old;
    created("1.3.0") public uint32 current;
  }
  class model_floating {
    public version float ver { 1.0 } compatibility { 0.5 };
    obsolete(0.75) public uint32 old;
    created(0.75) public uint32 current;
  }
  class model_inherited : private model_numeric {
    public string extra;
  }
  class model_envelope {
    public model_numeric value;
  }
  class model_typed_magic {
    public magic uint16 { 4660 };
    public uint32 value;
  }
  class model_digests {
    public digest raw;
    public digest[2] exact;
    public digest(md5) algorithm;
    public array digest[2] items;
    public optional<digest[2]> maybe;
  }
  class extended {
    public uint32 id;
    public uint32 known;
    public string tail;
  }
  class required_extension {
    public uint32 known;
  }
  class extension_holder {
    public extended value;
  }
  class box<T> {
    private T value expose readonly(public) as get;
  }
  instantiate integer_box = box<uint32>;
  instantiate text_box = box<string>;
  class sequence<uint64 N, T> {
    public array[N] T values;
  }
  instantiate short_sequence = sequence<2,uint16>;
  class nesting<T> {
    public T nested;
  }
  instantiate nested_box = nesting<integer_box>;
  class inherited_base {
    private uint32 identity expose readonly(public) as get_identity;
  }
  class inherited_middle : private inherited_base {
    private string label expose readonly(public) as get_label;
  }
  class inherited_other {
    private int32 count expose readonly(public) as get_count;
  }
  class inherited_record : private inherited_middle, protected inherited_other {
    public optional<string> note;
  }
}
