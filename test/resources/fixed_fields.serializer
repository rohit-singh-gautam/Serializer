serializer version 1;

namespace fixed_fields {
  enum phase { idle, active }

  class scalars stable_ids {
    public uint8 marker (1);
    public int16 delta (64);
    public uint32 sequence (16384);
    public float ratio (4194304);
    public bool enabled (3);
    public double reading (4);
    public char suffix (5);
  }

  class segmented stable_ids : public scalars (1) {
    public uint16 before_a (2);
    public uint16 before_b (3);
    public string label (4);
    public uint32 after_a (5);
    public uint32 after_b (6);
    public phase status (7);
    public uint8 tail_a (8);
    public uint8 tail_b (9);
    public scalars child (10);
    public union(uint32 = number, float = real) choice (11);
  }

  // More than one generated pack, including a final two-field batch.
  class long_run {
