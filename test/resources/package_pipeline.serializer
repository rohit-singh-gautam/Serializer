serializer version 1.24.0;

namespace pipeline {
  xml(namespace("urn:serializer:package-pipeline"), scalars(attribute));
  class payload {
    public uint32 id (1);
    public string label (2);
    public array uint32 values (3) xml(element, name("value"));
  }
  package archive {
    part main : payload {
      name("/main.data");
      content_type("application/vnd.serializer.pipeline");
      relationship("urn:serializer:pipeline:main");
      policy(defaults);
      requires_type(true);
      vocabularies("urn:serializer:package-pipeline", "urn:serializer:pipeline:understood");
    }
    part fixed : payload {
      name("/fixed.data");
      content_type("application/vnd.serializer.pipeline");
      relationship("urn:serializer:pipeline:fixed");
      codec(json);
      compression(stored);
      policy(fixed);
      occurs(0, 1);
    }
    part links : bytes {
      name(dynamic);
      content_type(dynamic);
      relationship("urn:serializer:pipeline:link");
      target_mode(both);
      occurs(0, unbounded);
    }
  }
}
