<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <OutputType>Library</OutputType>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <ProjectGuid>{AD9682C0-EB88-423B-A79E-55B38134B7B6}</ProjectGuid>
    <ProjectTypeGuids>{82B43B9B-A64C-4715-B499-D71E9CA2BD60};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>false</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <DeployExtension>false</DeployExtension>
    <CopyVsixExtensionFiles>false</CopyVsixExtensionFiles>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
  </ItemGroup>
  <!-- Link canonical assets so each build packages the current shared rules. -->
  <ItemGroup>
    <Content Include="..\serializer.tmLanguage.json" Link="Grammars\serializer.tmLanguage.json" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\vscode\language-configuration.json" Link="language-configuration.json" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="serializer.pkgdef" IncludeInVSIX="true" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE" Link="LICENSE" IncludeInVSIX="true" />
    <Content Include="..\..\logo\serializer_logo_128x128.png" Link="Resources\serializer_logo_128x128.png" IncludeInVSIX="true" />
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
  <Target Name="RequireVsSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(VsSdkTargetsImported)' != 'true'" Text="Restore Microsoft.VSSDK.BuildTools before building (MSBuild /restore)." />
  </Target>
  <!-- Keep the package name tied to the manifest version, independent of the compiler. -->
  <Target Name="SetSerializerVsixName" BeforeTargets="GetVsixSourceItems">
    <XmlPeek XmlInputPath="source.extension.vsixmanifest" Query="/*[local-name()='PackageManifest']/*[local-name()='Metadata']/*[local-name()='Identity']/@Version">
      <Output TaskParameter="Result" PropertyName="SerializerExtensionVersion" />
    </XmlPeek>
    <PropertyGroup>
      <TargetVsixContainerName>serializer-visual-studio-$(SerializerExtensionVersion).vsix</TargetVsixContainerName>
      <TargetVsixContainer>$(OutDir)$(TargetVsixContainerName)</TargetVsixContainer>
    </PropertyGroup>
  </Target>
  <Target Name="CopySerializerVsix" AfterTargets="CreateVsixContainer">
    <Copy SourceFiles="$(TargetVsixContainer)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\out\extensions" />
  </Target>
</Project>
