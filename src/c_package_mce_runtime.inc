R"cpackage(
static const char @p@_mc_uri[]="http://schemas.openxmlformats.org/markup-compatibility/2006";
static const char @p@_xml_uri[]="http://www.w3.org/XML/1998/namespace";
typedef struct @p@_mc_state {@p@_budget* budget;const char* part;} @p@_mc_state;
/* Keep every compatibility failure in the original package operation and metadata part. */
static inline bool @p@_mc_invalid(@p@_mc_state* state){@p@_fail(state->budget,@p@_invalid_metadata,state->part,"compatibility",NULL);return false;}
/* Split only XML whitespace, charging each owned token before allocation. */
static inline char* @p@_mc_next(@p@_mc_state* state,const char** current){while(**current&&srl_xml_space((unsigned char)**current)){++*current;}if(!**current){return NULL;}const char* begin=*current;while(**current&&!srl_xml_space((unsigned char)**current)){++*current;}const size_t length=(size_t)(*current-begin);if(@p@_consume(state->budget,@p@_work_units,length+1,state->part,"compatibility",NULL)){return NULL;}return @p@_string(state->budget,begin,length);}
/* Resolve original declaration scopes before any selected node is moved in the DOM. */
static inline const char* @p@_mc_prefix(@p@_mc_state* state,xmlNodePtr node,const char* prefix){size_t depth=0;for(xmlNodePtr parent=node;parent;parent=parent->parent){++depth;}if(@p@_consume(state->budget,@p@_work_units,strlen(prefix)+depth,state->part,"compatibility",NULL)){return NULL;}xmlNsPtr ns=xmlSearchNs(node->doc,node,BAD_CAST prefix);if(xmlValidateNCName(BAD_CAST prefix,0)||!ns||!ns->href||!*ns->href||xmlStrEqual(ns->href,BAD_CAST @p@_mc_uri)){@p@_mc_invalid(state);return NULL;}return (const char*)ns->href;}
/* Match inherited Ignorable URI identities without materializing whole namespace snapshots. */
static inline bool @p@_mc_ignored(@p@_mc_state* state,xmlNodePtr node,const char* uri){for(xmlNodePtr owner=node;owner&&owner->type==XML_ELEMENT_NODE;owner=owner->parent){if(@p@_consume(state->budget,@p@_work_units,1,state->part,"compatibility",NULL)){return false;}xmlChar* value=xmlGetNsProp(owner,BAD_CAST "Ignorable",BAD_CAST @p@_mc_uri);if(!value){continue;}const char* current=(const char*)value;char* token;bool found=false;while((token=@p@_mc_next(state,&current))!=NULL){const char* resolved=@p@_mc_prefix(state,owner,token);if(resolved&&!strcmp(resolved,uri)){found=true;}free(token);if(found||state->budget->status){break;}}xmlFree(value);if(found){return true;}if(state->budget->status){return false;}}return false;}
/* Resolve one ProcessContent expanded-name token, keeping its owned buffer available to the caller. */
static inline const char* @p@_mc_content_name(@p@_mc_state* state,xmlNodePtr node,char* token,const char** local){char* colon=strchr(token,':');if(!colon||colon==token||!colon[1]||strchr(colon+1,':')){@p@_mc_invalid(state);return NULL;}*colon='\0';*local=colon+1;if(strcmp(*local,"*")&&xmlValidateNCName(BAD_CAST *local,0)){@p@_mc_invalid(state);return NULL;}return @p@_mc_prefix(state,node,token);}
/* Match inherited expanded names and namespace wildcards against an element's original scope. */
static inline bool @p@_mc_process(@p@_mc_state* state,xmlNodePtr node){const char* uri=node->ns&&node->ns->href?(const char*)node->ns->href:"";for(xmlNodePtr owner=node;owner&&owner->type==XML_ELEMENT_NODE;owner=owner->parent){if(@p@_consume(state->budget,@p@_work_units,1,state->part,"compatibility",NULL)){return false;}xmlChar* value=xmlGetNsProp(owner,BAD_CAST "ProcessContent",BAD_CAST @p@_mc_uri);if(!value){continue;}const char* current=(const char*)value;char* token;bool found=false;while((token=@p@_mc_next(state,&current))!=NULL){const char* local=NULL;const char* resolved=@p@_mc_content_name(state,owner,token,&local);if(resolved&&!strcmp(resolved,uri)&&(!strcmp(local,"*")||xmlStrEqual(node->name,BAD_CAST local))){found=true;}free(token);if(found||state->budget->status){break;}}xmlFree(value);if(found){return true;}if(state->budget->status){return false;}}return false;}
/* Validate all directive syntax even on wrappers whose payload branch is not selected. */
static inline bool @p@_mc_declarations(@p@_mc_state* state,xmlNodePtr node){for(xmlAttrPtr attribute=node->properties;attribute;attribute=attribute->next){if(!attribute->ns||!xmlStrEqual(attribute->ns->href,BAD_CAST @p@_mc_uri)){continue;}const bool process=xmlStrEqual(attribute->name,BAD_CAST "ProcessContent");if(!process&&!xmlStrEqual(attribute->name,BAD_CAST "Ignorable")&&!xmlStrEqual(attribute->name,BAD_CAST "MustUnderstand")){return @p@_mc_invalid(state);}xmlChar* value=xmlNodeListGetString(node->doc,attribute->children,1);const char* current=value?(const char*)value:"";char* token;while((token=@p@_mc_next(state,&current))!=NULL){const char* local=NULL;const char* uri=process?@p@_mc_content_name(state,node,token,&local):@p@_mc_prefix(state,node,token);if(uri&&process&&!@p@_mc_ignored(state,node,uri)){@p@_mc_invalid(state);}free(token);if(state->budget->status){break;}}xmlFree(value);if(state->budget->status){return false;}}return true;}
/* Enforce required capabilities only on retained, selected or explicitly unwrapped markup. */
static inline bool @p@_mc_must(@p@_mc_state* state,xmlNodePtr node){xmlChar* value=xmlGetNsProp(node,BAD_CAST "MustUnderstand",BAD_CAST @p@_mc_uri);const char* current=value?(const char*)value:"";char* token;while((token=@p@_mc_next(state,&current))!=NULL){const char* uri=@p@_mc_prefix(state,node,token);if(uri&&strcmp(uri,@p@_rels_uri)){@p@_mc_invalid(state);}free(token);if(state->budget->status){break;}}xmlFree(value);return !state->budget->status;}
/* Validate complete Choice/Fallback attributes independently of selection. */
static inline bool @p@_mc_wrapper(@p@_mc_state* state,xmlNodePtr node,bool choice,bool* supported){*supported=false;for(xmlAttrPtr attribute=node->properties;attribute;attribute=attribute->next){if(!attribute->ns){if(!choice||!xmlStrEqual(attribute->name,BAD_CAST "Requires")){return @p@_mc_invalid(state);}}else if(!xmlStrEqual(attribute->ns->href,BAD_CAST @p@_mc_uri)){if(xmlStrEqual(attribute->ns->href,BAD_CAST @p@_xml_uri)||!@p@_mc_ignored(state,node,(const char*)attribute->ns->href)){return @p@_mc_invalid(state);}}}if(!choice){return true;}xmlChar* value=xmlGetProp(node,BAD_CAST "Requires");const char* current=value?(const char*)value:"";char* token;bool any=false;*supported=true;while((token=@p@_mc_next(state,&current))!=NULL){any=true;const char* uri=@p@_mc_prefix(state,node,token);if(uri&&strcmp(uri,@p@_rels_uri)){*supported=false;}free(token);if(state->budget->status){break;}}xmlFree(value);if(!any){return @p@_mc_invalid(state);}return !state->budget->status;}
/* Keep significant wrapper text visible to the final element-only Relationships grammar. */
static inline bool @p@_mc_whitespace(xmlNodePtr node){for(xmlNodePtr child=node->children;child;child=child->next){if(child->type!=XML_TEXT_NODE&&child->type!=XML_CDATA_SECTION_NODE){continue;}for(const xmlChar* value=child->content;value&&*value;++value){if(!srl_xml_space(*value)){return false;}}}return true;}
/* Admit an upper bound for namespace copies before reparenting removes their original declaring wrapper. */
static inline bool @p@_mc_namespace_copies(@p@_mc_state* state,xmlNodePtr node){if(@p@_consume(state->budget,@p@_work_units,1,state->part,"compatibility",NULL)){return false;}if(node->ns&&@p@_consume(state->budget,@p@_allocation_bytes,sizeof(xmlNs)+(size_t)xmlStrlen(node->ns->href)+(size_t)xmlStrlen(node->ns->prefix)+2,state->part,"compatibility",NULL)){return false;}for(xmlAttrPtr attribute=node->properties;attribute;attribute=attribute->next){if(attribute->ns&&@p@_consume(state->budget,@p@_allocation_bytes,sizeof(xmlNs)+(size_t)xmlStrlen(attribute->ns->href)+(size_t)xmlStrlen(attribute->ns->prefix)+2,state->part,"compatibility",NULL)){return false;}}for(xmlNodePtr child=node->children;child;child=child->next){if(child->type==XML_ELEMENT_NODE&&!@p@_mc_namespace_copies(state,child)){return false;}}return true;}
/* Move processed children with owned namespace identities before releasing their declaring wrapper. */
static inline bool @p@_mc_unwrap(@p@_mc_state* state,xmlNodePtr node){xmlNodePtr child=node->children;while(child){xmlNodePtr next=child->next;if(child->type==XML_ELEMENT_NODE&&!@p@_mc_namespace_copies(state,child)){return false;}xmlUnlinkNode(child);xmlAddPrevSibling(node,child);if(child->type==XML_ELEMENT_NODE&&xmlReconciliateNs(node->doc,child)<0){@p@_fail(state->budget,@p@_allocation,state->part,"compatibility",NULL);return false;}child=next;}xmlUnlinkNode(node);xmlFreeNode(node);return true;}
static inline int @p@_mc_visit(@p@_mc_state*,xmlNodePtr,bool);
/* Apply selected children before moving them so lexical namespace scopes remain intact. */
static inline bool @p@_mc_children(@p@_mc_state* state,xmlNodePtr node){xmlNodePtr child=node->children;while(child){xmlNodePtr next=child->next;if(child->type==XML_ELEMENT_NODE){const int action=@p@_mc_visit(state,child,false);if(action<0){return false;}if(action==1){if(!@p@_mc_unwrap(state,child)){return false;}}else if(action==2){xmlUnlinkNode(child);xmlFreeNode(child);}}child=next;}return !state->budget->status;}
)cpackage"
R"cpackage(
/* Return keep/unwrap/discard, or fail without publishing a partially processed package catalog. */
static inline int @p@_mc_visit(@p@_mc_state* state,xmlNodePtr node,bool selected){if(@p@_consume(state->budget,@p@_work_units,1,state->part,"compatibility",NULL)||!@p@_mc_declarations(state,node)){return -1;}const char* uri=node->ns&&node->ns->href?(const char*)node->ns->href:"";if(strcmp(uri,@p@_rels_uri)&&@p@_mc_ignored(state,node,uri)){if(!@p@_mc_process(state,node)){return state->budget->status?-1:2;}for(xmlAttrPtr attribute=node->properties;attribute;attribute=attribute->next){if(attribute->ns&&xmlStrEqual(attribute->ns->href,BAD_CAST @p@_xml_uri)&&(xmlStrEqual(attribute->name,BAD_CAST "base")||xmlStrEqual(attribute->name,BAD_CAST "lang")||xmlStrEqual(attribute->name,BAD_CAST "space"))){@p@_mc_invalid(state);return -1;}}return @p@_mc_must(state,node)&&@p@_mc_children(state,node)?1:-1;}if(state->budget->status){return -1;}
  if(!strcmp(uri,@p@_mc_uri)){if(xmlStrEqual(node->name,BAD_CAST "AlternateContent")){bool unused=false;if(!@p@_mc_wrapper(state,node,false,&unused)||!@p@_mc_whitespace(node)){@p@_mc_invalid(state);return -1;}size_t choices=0;bool fallback=false;xmlNodePtr branch=NULL;for(xmlNodePtr child=node->children;child;child=child->next){if(child->type!=XML_ELEMENT_NODE){continue;}if(!@p@_mc_declarations(state,child)){return -1;}const char* child_uri=child->ns&&child->ns->href?(const char*)child->ns->href:"";if(strcmp(child_uri,@p@_rels_uri)&&@p@_mc_ignored(state,child,child_uri)&&!@p@_mc_process(state,child)){if(state->budget->status){return -1;}continue;}if(strcmp(child_uri,@p@_mc_uri)){@p@_mc_invalid(state);return -1;}bool understood=false;if(xmlStrEqual(child->name,BAD_CAST "Choice")&&!fallback){++choices;if(!@p@_mc_wrapper(state,child,true,&understood)){return -1;}if(!branch&&understood){branch=child;}}else if(xmlStrEqual(child->name,BAD_CAST "Fallback")&&choices&&!fallback){fallback=true;if(!@p@_mc_wrapper(state,child,false,&understood)){return -1;}if(!branch){branch=child;}}else{@p@_mc_invalid(state);return -1;}}if(!choices||!@p@_mc_must(state,node)){@p@_mc_invalid(state);return -1;}if(branch&&@p@_mc_visit(state,branch,true)<0){return -1;}xmlNodePtr child=node->children;while(child){xmlNodePtr next=child->next;if(child!=branch){xmlUnlinkNode(child);xmlFreeNode(child);}child=next;}if(branch&&!@p@_mc_unwrap(state,branch)){return -1;}return 1;}
    if(!selected||(!xmlStrEqual(node->name,BAD_CAST "Choice")&&!xmlStrEqual(node->name,BAD_CAST "Fallback"))){@p@_mc_invalid(state);return -1;}bool understood=false;if(!@p@_mc_wrapper(state,node,xmlStrEqual(node->name,BAD_CAST "Choice")!=0,&understood)){return -1;}return @p@_mc_must(state,node)&&@p@_mc_children(state,node)?1:-1;
  }
  if(!@p@_mc_must(state,node)||!@p@_mc_children(state,node)){return -1;}
  /* Keep declarations alive until all ignored foreign attributes have been classified. */
  xmlAttrPtr attribute=node->properties;while(attribute){xmlAttrPtr next=attribute->next;if(attribute->ns&&!xmlStrEqual(attribute->ns->href,BAD_CAST @p@_mc_uri)&&!xmlStrEqual(attribute->ns->href,BAD_CAST @p@_rels_uri)&&@p@_mc_ignored(state,node,(const char*)attribute->ns->href)){xmlRemoveProp(attribute);}attribute=next;if(state->budget->status){return -1;}}
  attribute=node->properties;while(attribute){xmlAttrPtr next=attribute->next;if(attribute->ns&&xmlStrEqual(attribute->ns->href,BAD_CAST @p@_mc_uri)){xmlRemoveProp(attribute);}attribute=next;}return 0;
}
/* Permit AlternateContent at the document root but require exactly one retained element. */
static inline bool @p@_mc_apply(xmlDocPtr document,const char* part,@p@_budget* budget){@p@_mc_state state={budget,part};if(@p@_consume(budget,@p@_allocation_bytes,sizeof(xmlNode),part,"compatibility",NULL)){return false;}xmlNodePtr original=xmlDocGetRootElement(document);xmlNodePtr container=xmlNewNode(NULL,BAD_CAST "serializer_compatibility");if(!container){@p@_fail(budget,@p@_allocation,part,"compatibility",NULL);return false;}xmlUnlinkNode(original);xmlDocSetRootElement(document,container);xmlAddChild(container,original);if(!@p@_mc_children(&state,container)||!@p@_mc_whitespace(container)){return @p@_mc_invalid(&state);}xmlNodePtr root=NULL;for(xmlNodePtr child=container->children;child;child=child->next){if(child->type==XML_ELEMENT_NODE){if(root){return @p@_mc_invalid(&state);}root=child;}}if(!root){return @p@_mc_invalid(&state);}xmlUnlinkNode(root);xmlDocSetRootElement(document,root);xmlFreeNode(container);return !budget->status;}
)cpackage"
