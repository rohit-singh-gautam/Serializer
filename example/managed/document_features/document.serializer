namespace managed_document_features {
  class document_metrics stable_ids managed {
    public double words_per_page (1) {10.0};
    public uint32 page_count (2) {1};
    public transient uint64 lookup_cache {0};
    public function double estimated_words() readonly
      expression(words_per_page * to_double(page_count));
    public function void set_metrics(double words, uint32 pages) edit cpp {
      set_words_per_page(words);
      if (pages == 0) { throw ::std::invalid_argument{"A document needs at least one page"}; }
      set_page_count(pages);
    };
    public function void add_pages(uint32 amount) edit;
  }
}

