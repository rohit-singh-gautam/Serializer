serializer version 1;

// A deliberately large, shared example contract. Generate it through CMake, not by hand.
// All fields have stable explicit IDs; all referenced types are declared before use.
namespace iostream_model {
enum health_state { unknown, healthy, degraded, unavailable }
enum severity { debug, info, warning, error, critical }
enum device_role { compute, storage, network, controller }
enum deployment_state { pending, running, succeeded, failed, rolled_back }

// The capture interval and its clock properties.
class time_range stable_ids {
  public uint64 start_ns (1);
  public uint64 end_ns (2);
  public uint64 sample_period_ns (3);
  public uint64 clock_offset_ns (4);
  public uint32 sequence (5);
  public uint32 missed_samples (6);
  public bool synchronized (7);
  public string clock_source (8);
  public string timezone (9);
  public string label (10);
}

// The process that produced this archive.
class source_identity stable_ids {
  public string source_id (1);
  public string host_name (2);
  public string agent_name (3);
  public string agent_version (4);
  public string instance_id (5);
  public string boot_id (6);
  public string tenant (7);
  public string environment (8);
  public uint32 process_id (9);
  public uint64 started_ns (10);
  public bool trusted (11);
  public map(string) string labels (12);
}

// Physical placement independent of network addresses.
class location stable_ids {
  public string country (1);
  public string region (2);
  public string city (3);
  public string building (4);
  public string floor (5);
  public string room (6);
  public string aisle (7);
  public string rack_name (8);
  public double latitude (9);
  public double longitude (10);
  public double elevation_m (11);
  public map(string) string labels (12);
}

// An operational contact with escalation information.
class contact stable_ids {
  public string name (1);
  public string team (2);
  public string role (3);
  public string email (4);
  public string phone (5);
  public string timezone (6);
  public string schedule (7);
  public string escalation_group (8);
  public uint32 priority (9);
  public bool enabled (10);
  public array string channels (11);
  public map(string) string labels (12);
}

// Teams and contacts responsible for an asset.
class ownership stable_ids {
  public string organization (1);
  public string department (2);
  public string cost_center (3);
  public string project (4);
  public string account (5);
  public string tenant (6);
  public contact primary_contact (7);
  public array contact escalation_contacts (8);
  public uint64 assigned_ns (9);
  public uint64 reviewed_ns (10);
  public bool shared (11);
  public map(string) string labels (12);
}

// Reproducible software build provenance.
class build_info stable_ids {
  public string product (1);
  public string version (2);
  public string revision (3);
  public string branch (4);
  public string compiler (5);
  public string target (6);
  public string build_mode (7);
  public string package_digest (8);
  public uint64 built_ns (9);
  public uint32 api_version (10);
  public bool verified (11);
  public array string features (12);
}

// Operating system inventory.
class os_info stable_ids {
  public string family (1);
  public string distribution (2);
  public string release (3);
  public string kernel (4);
  public string architecture (5);
  public string machine_id (6);
  public string boot_parameters (7);
  public string locale (8);
  public uint64 boot_ns (9);
  public uint64 uptime_seconds (10);
  public bool virtualized (11);
  public array string capabilities (12);
}

// Processor identity and cumulative counters.
class cpu_info stable_ids {
  public string vendor (1);
  public string model (2);
  public string architecture (3);
  public uint32 socket (4);
  public uint32 cores (5);
  public uint32 threads (6);
  public uint64 frequency_hz (7);
  public uint64 user_ns (8);
  public uint64 system_ns (9);
  public uint64 idle_ns (10);
  public double utilization (11);
  public array double core_utilization (12);
}

// Memory capacities and pressure measurements.
class memory_info stable_ids {
  public uint64 total_bytes (1);
  public uint64 free_bytes (2);
  public uint64 available_bytes (3);
  public uint64 cached_bytes (4);
  public uint64 buffered_bytes (5);
  public uint64 swap_total_bytes (6);
  public uint64 swap_used_bytes (7);
  public uint64 page_faults (8);
  public uint64 major_faults (9);
  public double pressure (10);
  public bool ecc_enabled (11);
  public array uint64 node_bytes (12);
}

// A physical storage device and its health counters.
class disk_info stable_ids {
  public string device_id (1);
  public string model (2);
  public string serial_number (3);
  public string firmware (4);
  public string bus (5);
  public uint64 capacity_bytes (6);
  public uint64 read_bytes (7);
  public uint64 written_bytes (8);
  public uint64 read_operations (9);
  public uint64 write_operations (10);
  public double temperature_c (11);
  public health_state health (12);
}

// Interface configuration and traffic counters.
class network_interface stable_ids {
  public string name (1);
  public string hardware_address (2);
  public array string addresses (3);
