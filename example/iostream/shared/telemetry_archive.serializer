  public uint32 parent_id (2);
  public string executable (3);
  public string command_line (4);
  public string user (5);
  public string working_directory (6);
  public uint64 started_ns (7);
  public uint64 resident_bytes (8);
  public uint64 virtual_bytes (9);
  public uint64 cpu_ns (10);
  public uint32 thread_count (11);
  public health_state health (12);
}

