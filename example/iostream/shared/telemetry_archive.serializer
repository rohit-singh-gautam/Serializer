// Configuration policy attached to a device.
class device_config stable_ids {
  public uint32 revision (1);
  public string profile (2);
  public string management_address (3);
  public string update_channel (4);
  public uint64 polling_period_ns (5);
  public uint64 timeout_ns (6);
  public uint32 retry_count (7);
  public bool collection_enabled (8);
  public bool remote_access (9);
  public array string enabled_metrics (10);
  public array string disabled_checks (11);
  public map(string) string parameters (12);
}

// A scalar sample with an explicit numeric union.
class counter_sample stable_ids {
  public string name (1);
  public string unit (2);
  public uint64 timestamp_ns (3);
  public uint64 sequence (4);
  public union(uint64 = integer_value, double = real_value) value (5);
  public double minimum (6);
  public double maximum (7);
  public double average (8);
  public uint32 observations (9);
  public bool valid (10);
  public severity level (11);
  public map(string) string labels (12);
}

// Histogram boundaries and counts with matching array lengths.
class histogram stable_ids {
  public string name (1);
  public string unit (2);
  public array double bounds (3);
  public array uint64 counts (4);
  public uint64 count (5);
  public double sum (6);
  public double minimum (7);
  public double maximum (8);
  public double mean (9);
  public uint64 start_ns (10);
  public uint64 end_ns (11);
  public map(string) string labels (12);
}

// A sizeable time series used to exercise multi-batch transfers.
class metric_series stable_ids {
  public string name (1);
  public string unit (2);
  public string description (3);
  public array uint64 timestamps_ns (4);
  public array double values (5);
  public array uint32 quality_flags (6);
  public double minimum (7);
  public double maximum (8);
  public double average (9);
  public uint64 period_ns (10);
  public bool monotonic (11);
  public map(string) string labels (12);
}

// A trace span and its bounded event annotations.
class trace_span stable_ids {
  public string trace_id (1);
  public string span_id (2);
  public string parent_id (3);
  public string operation (4);
  public string service (5);
  public uint64 started_ns (6);
  public uint64 duration_ns (7);
  public uint32 status_code (8);
  public bool sampled (9);
  public array string events (10);
  public map(string) string attributes (11);
  public severity level (12);
}

// A log entry whose message can contain escapes and Unicode.
class log_entry stable_ids {
  public uint64 timestamp_ns (1);
  public uint64 sequence (2);
  public severity level (3);
  public string source (4);
  public string category (5);
  public string message (6);
  public string trace_id (7);
  public string span_id (8);
  public uint32 process_id (9);
  public uint32 thread_id (10);
  public bool structured (11);
  public map(string) string attributes (12);
}

