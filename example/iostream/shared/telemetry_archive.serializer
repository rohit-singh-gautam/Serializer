  public uint64 speed_bits_per_second (5);
  public uint64 received_bytes (6);
  public uint64 sent_bytes (7);
  public uint64 received_packets (8);
  public uint64 sent_packets (9);
  public uint64 dropped_packets (10);
  public bool link_up (11);
  public map(string) uint64 counters (12);
}

