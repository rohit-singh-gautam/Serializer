  public uint32 required_samples (8);
  public bool enabled (9);
  public array string destinations (10);
  public map(string) string labels (11);
  public map(string) double thresholds (12);
}

// An alert occurrence connected to a rule.
class alert_event stable_ids {
  public string event_id (1);
  public string rule_id (2);
  public string device_id (3);
  public string summary (4);
  public string details (5);
  public severity level (6);
  public uint64 opened_ns (7);
  public uint64 updated_ns (8);
  public uint64 closed_ns (9);
  public bool acknowledged (10);
  public string acknowledged_by (11);
  public map(string) string labels (12);
}

