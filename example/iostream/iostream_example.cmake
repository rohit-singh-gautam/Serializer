include_guard(GLOBAL)

# Generate the shared model once while retaining each lesson's concrete stream types.
function(serializer_add_iostream_example example)
  set(directory "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
  if(NOT TARGET serializer_iostream_support)
    add_library(serializer_iostream_models INTERFACE)
    serializer_generate(TARGET serializer_iostream_models
      SCHEMAS "${directory}/shared/telemetry_archive.serializer")
    add_library(serializer_iostream_support STATIC "${directory}/shared/example_support.cpp")
    target_include_directories(serializer_iostream_support PUBLIC "${directory}/shared")
    target_link_libraries(serializer_iostream_support PUBLIC serializer_iostream_models)
    if(MSVC)
      target_compile_options(serializer_iostream_support PRIVATE /W4 /WX)
    else()
      target_compile_options(serializer_iostream_support PRIVATE -Wall -Wextra -Werror -Wpedantic)
    endif()
  endif()
  set(target "serializer_iostream_${example}")
  add_executable("${target}" "${directory}/${example}/main.cpp")
  serializer_example_runtime_dlls("${target}")
  target_link_libraries("${target}" PRIVATE serializer_iostream_support)
  if(SERIALIZER_BUILD_TESTS OR PROJECT_IS_TOP_LEVEL)
    add_test(NAME "${target}" COMMAND "${target}")
    set_tests_properties("${target}" PROPERTIES LABELS serializer_iostream TIMEOUT 60)
  endif()
  if(MSVC)
    target_compile_options("${target}" PRIVATE /W4 /WX)
  else()
    target_compile_options("${target}" PRIVATE -Wall -Wextra -Werror -Wpedantic)
  endif()
endfunction()
