include_guard(GLOBAL)

# Prefer explicit capabilities, retaining source and older static-package discovery.
function(serializer_compression_example_available result backend)
  get_property(has_metadata TARGET Serializer::runtime PROPERTY "SERIALIZER_WITH_${backend}" SET)
  if(has_metadata)
    get_target_property(enabled Serializer::runtime "SERIALIZER_WITH_${backend}")
    if(enabled)
      set("${result}" ON PARENT_SCOPE)
    else()
      set("${result}" OFF PARENT_SCOPE)
    endif()
    return()
  endif()
  get_target_property(definitions Serializer::runtime COMPILE_DEFINITIONS)
  set(enabled OFF)
  foreach(definition IN LISTS definitions)
    if(definition MATCHES "^SERIALIZER_WITH_${backend}=\\$<BOOL:([^>]+)>$")
      set(enabled "${CMAKE_MATCH_1}")
    elseif(definition STREQUAL "SERIALIZER_WITH_${backend}=1")
      set(enabled ON)
    endif()
  endforeach()
  # Static installed runtimes retain private codec dependencies in their link interface.
  get_target_property(libraries Serializer::runtime INTERFACE_LINK_LIBRARIES)
  if((backend STREQUAL "ZSTD" AND libraries MATCHES "zstd::") OR
      (backend STREQUAL "LZ4" AND libraries MATCHES "LZ4::lz4") OR
      (backend STREQUAL "ZLIB" AND libraries MATCHES "ZLIB::ZLIB"))
    set(enabled ON)
  endif()
  set("${result}" "${enabled}" PARENT_SCOPE)
endfunction()

# Share generation and support code when several compression lessons are selected.
function(serializer_add_compression_example example)
  set(directory "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
  if(NOT TARGET serializer_compression_example_support)
    add_library(serializer_compression_models INTERFACE)
    serializer_generate(TARGET serializer_compression_models
      SCHEMAS "${directory}/shared/document.serializer")
    add_library(serializer_compression_example_support STATIC "${directory}/shared/example_support.cpp")
    target_include_directories(serializer_compression_example_support PUBLIC "${directory}/shared")
    target_link_libraries(serializer_compression_example_support PUBLIC serializer_compression_models)
    if(MSVC)
      target_compile_options(serializer_compression_example_support PRIVATE /W4 /WX)
    else()
      target_compile_options(serializer_compression_example_support PRIVATE -Wall -Wextra -Werror -Wpedantic)
    endif()
  endif()
  set(target "serializer_compression_${example}")
  add_executable("${target}" "${directory}/${example}/main.cpp")
  serializer_example_runtime_dlls("${target}")
  target_link_libraries("${target}" PRIVATE serializer_compression_example_support)
  if(SERIALIZER_BUILD_TESTS OR PROJECT_IS_TOP_LEVEL)
    add_test(NAME "${target}" COMMAND "${target}")
    set_tests_properties("${target}" PROPERTIES LABELS serializer_compression_examples TIMEOUT 60)
  endif()
  if(MSVC)
    target_compile_options("${target}" PRIVATE /W4 /WX)
  else()
    target_compile_options("${target}" PRIVATE -Wall -Wextra -Werror -Wpedantic)
  endif()
endfunction()
