# Reimport only the authoritative build-owned model, preserving authored schemas.
foreach(argument IN ITEMS COMPILER BINARY_DIRECTORY SOURCE_XSD)
  if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
    message(FATAL_ERROR "Missing generated XSD import argument: ${argument}")
  endif()
endforeach()
file(REAL_PATH "${BINARY_DIRECTORY}" binary_directory)
set(generated_directory "${binary_directory}/generated/imported")
file(MAKE_DIRECTORY "${generated_directory}")
file(REAL_PATH "${generated_directory}" generated_directory)
cmake_path(IS_PREFIX binary_directory "${generated_directory}" NORMALIZE is_build_owned)
if(NOT is_build_owned OR generated_directory STREQUAL binary_directory)
  message(FATAL_ERROR "Generated XSD import directory must remain under the CMake binary directory")
endif()
set(schema "${generated_directory}/model.serializer")
if(IS_DIRECTORY "${schema}" OR IS_SYMLINK "${schema}")
  message(FATAL_ERROR "Generated XSD import destination must be an ordinary build-owned file")
endif()
# The CLI protects hand-authored output. This one exact file is declared GENERATED by CMake.
file(REMOVE "${schema}")
execute_process(COMMAND "${COMPILER}" --import-xsd "${SOURCE_XSD}" --namespace xsd_example
  --root order --output "${schema}" --depfile "${schema}.d" RESULT_VARIABLE import_status)
if(NOT import_status EQUAL 0)
  message(FATAL_ERROR "Serializer XSD import failed: ${import_status}")
endif()
