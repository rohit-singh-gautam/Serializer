serializer version 1.7.0;

class optional_detail {
  public string name;
  public array uint32 numbers;
}

class optional_result<T> {
  public optional<T> value;
}

class example_model stable_ids {
  public version uint32 (1) { 1 };
  public optional<uint32> absent (2);
